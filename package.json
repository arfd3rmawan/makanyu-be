    "pg": "^8.20.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "products",
    "cards",
